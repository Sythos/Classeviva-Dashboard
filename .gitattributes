# Nel repository i file restano con fine riga LF, anche committando da Windows:
# Home Assistant, HACS e le GitHub Actions girano su Linux.
* text=auto eol=lf

# File binari: nessuna conversione
*.png binary
*.jpg binary
*.pdf binary

# Le fonti della guida e i file CI restano fuori dagli archivi sorgente di un tag.
/pages export-ignore
/.github export-ignore
